<h1>Inventory Dashboard</h1>

<h2>Displaced People Count</h2>
<p>Total People: <%= @people_count %></p>

<h2>Food Stock</h2>
<table>
  <thead>
    <tr>
      <th>Item</th>
      <th>Quantity Available</th>
    </tr>
  </thead>
  <tbody>
    <% @food_stock.each do |food| %>
      <tr>
        <td><%= food.name %></td>
        <td><%= food.quantity %></td>
        <td>
          <% if food.low_stock? %>
            <span style="color: red;">Low Stock</span>
          <% else %>
            <span style="color: green;">Sufficient</span>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<h2>Sleeping Equipment Stock</h2>
<table>
  <thead>
    <tr>
      <th>Item</th>
      <th>Quantity Available</th>
    </tr>
  </thead>
  <tbody>
    <% @equipment_stock.each do |equipment| %>
      <tr>
        <td><%= equipment.name %></td>
        <td><%= equipment.quantity %></td>
        <td>
          <% if equipment.low_stock? %>
            <span style="color: red;">Low Stock</span>
          <% else %>
            <span style="color: green;">Sufficient</span>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
