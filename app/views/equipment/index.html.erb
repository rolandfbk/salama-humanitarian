<h1>Sleeping Equipment Stock</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Quantity</th>
    </tr>
  </thead>
  <tbody>
    <% @equipment.each do |equipment| %>
      <tr>
        <td><%= equipment.name %></td>
        <td><%= equipment.quantity %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to 'Add Equipment Item', new_equipment_path %>
<%= link_to 'Dashboard', root_path %>
