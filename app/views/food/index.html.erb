<h1>Food Stock</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Quantity</th>
    </tr>
  </thead>
  <tbody>
    <% @food.each do |food| %>
      <tr>
        <td><%= food.name %></td>
        <td><%= food.quantity %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to 'Add Food Item', new_food_path %>
