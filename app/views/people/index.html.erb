<h1>People List</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Age</th>
      <th>Category</th>
    </tr>
  </thead>
  <tbody>
    <% @people.each do |person| %>
      <tr>
        <td><%= person.name %></td>
        <td><%= person.age %></td>
        <td><%= person.category %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to 'Add Person', new_person_path %>
