<h1>Welcome to the Humanitarian Management System</h1>

<% if current_user %>
  <p>Welcome, <%= "#{current_user.first_name} #{current_user.last_name}" %>!</p>

  <% if current_user.admin? %>
    <h2>Admin Dashboard</h2>
    <ul>
      <li><%= link_to 'Manage Users', admin_users_path %></li>
      <li><%= link_to 'Inventory Board', inventory_index_path %></li>
      <li><%= link_to 'Resource Allocation Report', reports_path %></li>
    </ul>
  <% elsif current_user.volunteer? %>
    <h2>Volunteer Dashboard</h2>
    <ul>
      <li><%= link_to 'View Inventory', inventory_index_path %></li>
      <li><%= link_to 'Resource Allocation Report', reports_path %></li>
    </ul>
  <% end %>
<% else %>
  <p><%= link_to 'Log in', new_user_session_path %> or <%= link_to 'Sign up', new_user_registration_path %> to access the system.</p>
<% end %>
