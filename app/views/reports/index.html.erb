<%= render 'admin/users/adminlinks' %>

<h1>Resource Allocation Report</h1>

<h2>People Count by Category</h2>
<table>
  <tr>
    <th>Category</th>
    <th>Count</th>
  </tr>
  <% @people_count.each do |category, count| %>
    <tr>
      <td><%= category.capitalize %></td>
      <td><%= count %></td>
    </tr>
  <% end %>
</table>

<h2>Allocated Food</h2>
<table>
  <tr>
    <th>Food Item</th>
    <th>Count</th>
  </tr>
  <% @allocated_food_counts.each do |food, count| %>
    <tr>
      <td><%= food %></td>
      <td><%= count %></td>
    </tr>
  <% end %>
</table>

<h2>Allocated Equipment</h2>
<table>
  <tr>
    <th>Equipment Item</th>
    <th>Count</th>
  </tr>
  <% @allocated_equipment_counts.each do |equipment, count| %>
    <tr>
      <td><%= equipment %></td>
      <td><%= count %></td>
    </tr>
  <% end %>
</table>

<h2>Remaining Stock</h2>
<h3>Food</h3>
<table>
  <tr>
    <th>Item</th>
    <th>Quantity Available</th>
  </tr>
  <% @food_stock.each do |food| %>
    <tr>
      <td><%= food.name %></td>
      <td><%= food.quantity %></td>
    </tr>
  <% end %>
</table>

<h3>Equipment</h3>
<table>
  <tr>
    <th>Item</th>
    <th>Quantity Available</th>
  </tr>
  <% @equipment_stock.each do |equipment| %>
    <tr>
      <td><%= equipment.name %></td>
      <td><%= equipment.quantity %></td>
    </tr>
  <% end %>
</table>

